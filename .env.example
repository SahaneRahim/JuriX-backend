# ============================================================
# JuriX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Application ----
ENVIRONMENT=development
DEBUG=true

# ---- Neon PostgreSQL (pgvector) ----
# Get this from your Neon project dashboard → Connection string
# ⚠️  Add ?sslmode=require at the end for production
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-yyy.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Upstash Redis ----
# Get this from your Upstash console → REST API or Redis URL
# Use rediss:// (with SSL) for Upstash
REDIS_URL=rediss://:your-upstash-password@your-endpoint.upstash.io:6379

# ---- Gemini API (Google AI Studio) ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- LlamaParse (LlamaCloud) ----
LLAMA_CLOUD_API_KEY=llx-your-llama-parse-key-here

# ---- Meilisearch ----
# If self-hosted:
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=your-meilisearch-master-key

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-a-strong-random-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- CORS ----
# Vercel frontend URL(s), comma-separated (no trailing slash)
# Example: https://jurix.vercel.app,https://www.jurix.cm
ALLOWED_ORIGINS=https://jurix.vercel.app
