# ============================================================
# JuriX Backend — Environment Variables
# Copiez ce fichier vers .env et renseignez vos valeurs.
# Toutes les cles ci-dessous sont réellement lues par app/core/config.py.
# ============================================================

# ---- Application ----
# ENVIRONMENT != development rend SECRET_KEY obligatoire (pas de valeur par defaut)
ENVIRONMENT=development
DEBUG=true

# ---- PostgreSQL + pgvector (Supabase, Neon, ou local) ----
# Le driver asyncpg est obligatoire : postgresql+asyncpg://
#
# NE METTEZ JAMAIS ?sslmode= NI ?channel_binding= DANS CETTE URL.
# Le dialecte asyncpg de SQLAlchemy transmet les parametres inconnus tels quels
# a asyncpg.connect(), dont la signature ne les accepte pas :
#     TypeError: connect() got an unexpected keyword argument 'sslmode'
# L'erreur ne surgit qu'au premier acces a la base, apres un demarrage en
# apparence reussi. Les boutons « copier » de Supabase et de Neon donnent
# pourtant cette URL : retirez le parametre et posez PGSSLMODE ci-dessous.
# La configuration refuse de se charger si vous l'oubliez.
#
# Developpement local, conteneur du README (port 5433, base jurix_dev) :
DATABASE_URL=postgresql+asyncpg://jurix:jurix@localhost:5433/jurix_dev
#
# Production, exemple Supabase — POOLER (port 6543), pas la connexion directe :
# la connexion directe de Supabase est IPv6 uniquement depuis 2024, et tous les
# hebergeurs ne sortent pas en IPv6. Le pooler est joignable en IPv4.
# Son mode transaction ne supporte pas les instructions preparees, d'ou
# prepared_statement_cache_size=0 — ce parametre-la, contrairement a sslmode,
# est bien consomme par SQLAlchemy et ne fuit pas vers asyncpg.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:MOTDEPASSE@aws-0-<region>.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0

# TLS de la base. Lue par asyncpg ET par libpq (psycopg2, psql, pg_dump) — une
# seule variable pour les deux pilotes, la ou l'URL en aurait demande deux noms
# differents.
PGSSLMODE=require

# ---- Gemini API (Google AI Studio) ----
# Modeles Flash disponibles : gemini-3.8-flash | 3.7 | 3.6 | 3.5 | 3.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Extraction des PDF ----
# L'extraction passe par Gemini multimodal : meme cle que la generation.
# Pages envoyees par appel. La limite du modele est de 65 536 jetons EN SORTIE ;
# a ~2400 caracteres par page, 20 pages en produisent ~13 000. Le palier gratuit
# plafonne a 20 appels par jour : agrandir le lot economise des appels.
# PDF_EXTRACTION_PAGES_PER_CALL=20
# Delai d'un appel d'extraction, distinct de GEMINI_TIMEOUT_S : un lot de vingt
# pages scannees demande plusieurs minutes. Mesure : 120 s ne suffisaient pas.
# PDF_EXTRACTION_TIMEOUT_S=600
# Poids maximal d'un lot. Le nombre de pages ne dit rien du poids : vingt pages
# scannees pesent 10 Mo la ou vingt pages de texte en pesent 1.
# PDF_EXTRACTION_MAX_BATCH_MB=6.0
# Cache d'extraction par sha256 : un fichier deja traite n'est jamais repaye
OCR_CACHE_DIR=./data/ocr_cache

# ---- Securite / JWT ----
# Generer avec : openssl rand -hex 32
SECRET_KEY=generate-a-strong-random-key-here
ALGORITHM=HS256
# Duree de session d'un compte ordinaire. 30 jours : l'interet d'un compte est
# de retrouver ses conversations, et 30 minutes deconnectait en pleine session.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Duree BEAUCOUP plus courte des que le compte porte un role privilegie : les
# JWT sont sans etat, /logout ne revoque rien, et il n'existe aucune liste de
# revocation. Un jeton superadmin vole ne doit pas vivre un mois.
ADMIN_TOKEN_EXPIRE_MINUTES=720

# ---- Connexion Google (Google Identity Services) ----
# Identifiant client OAuth de type « Web application », console Google Cloud.
# Il n'y a PAS de client secret : le mode « credential » rend le jeton a une
# fonction JavaScript, sans redirection.
# VIDE = connexion Google desactivee, et POST /auth/google repond 503. Ne jamais
# verifier un jeton sans audience : cela accepterait n'importe quel jeton Google.
GOOGLE_CLIENT_ID=

# ---- Compte administrateur initial (scripts/create_admin.py) ----
# Le script est idempotent : il cree le compte ou met a jour son mot de passe.
ADMIN_EMAIL=admin@jurix.cm
ADMIN_PASSWORD=change-me-strong-password

# ---- Uploads ----
# Taille maximale par fichier, en octets (defaut 1 Go)
MAX_UPLOAD_SIZE=1073741824

# ---- OCR local (fallback Tesseract) ----
# Chemin du binaire tesseract. Sous Linux/Docker : /usr/bin/tesseract
TESSERACT_PATH=/usr/bin/tesseract

# ---- CORS ----
# URL(s) du front, separees par des virgules, sans slash final
# Exemple : https://jurix.vercel.app,https://www.jurix.cm
ALLOWED_ORIGINS=https://jurix.vercel.app

# ── Reglages de recherche (facultatifs, valeurs par defaut dans config.py) ────
# Ils etaient absents de ce fichier alors qu'ils pilotent tout le classement.
# Attention : config.py pose `extra = "ignore"`, donc une cle mal orthographiee
# ici est ignoree EN SILENCE.
# EMBEDDING_DIM=3072              # doit correspondre a la colonne en base
# GEMINI_TIMEOUT_S=120
# RERANK_ENABLED=true
# RERANK_LLM_ENABLED=false
# RERANK_LLM_TOP_N=20
# RERANK_LLM_TIMEOUT_S=4.0
# TITLE_TRIGRAM_THRESHOLD=0.5     # tolerance aux fautes sur les titres
# RRF_K=60                        # fusion des classements texte et semantique
# TEXT_WEIGHT=0.4
# SEMANTIC_WEIGHT=0.6

# ---- Documents d'origine (PDF) ----
# VIDE = les PDF sont lus dans ./data/uploads (developpement).
# NON VIDE = ils sont recuperes en HTTPS, ce qui est obligatoire sur un
# hebergeur au disque ephemere : les lignes en base survivent au redeploiement,
# pas les fichiers.
# Exemple Supabase Storage, bucket public nomme « documents » :
# DOCUMENTS_BASE_URL=https://<ref>.supabase.co/storage/v1/object/public/documents
DOCUMENTS_BASE_URL=
# Plafond du cache disque, en Mo. 0 le desactive.
DOCUMENTS_CACHE_MAX_MB=96

# ---- Envoi de courriel (Brevo) ----
# VIDE = envoi desactive. Inscription et connexion continuent de fonctionner ;
# seuls la verification d'adresse et le lien de reinitialisation ne partent pas.
# Le transport est l'API HTTPS de Brevo, jamais SMTP : les hebergeurs gratuits
# bloquent les ports sortants 25, 465 et 587.
BREVO_API_KEY=
# L'adresse VERIFIEE dans Brevo. Sur une adresse gratuite (gmail.com), Brevo ne
# peut pas l'authentifier et reecrit l'expediteur en @brevosend.com.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JuriX

# Racine des liens contenus dans les courriels. VIDE = aucun message porteur
# d'un lien n'est envoye, plutot que d'expedier un lien mort.
# FRONTEND_BASE_URL=https://jurix.vercel.app
FRONTEND_BASE_URL=

# Intervalle de purge des caches, en secondes. 900 en developpement.
CACHE_CLEANUP_INTERVAL_S=900
