# Un seul domaine pour tout JuriX : le front et l'API, servis par la meme VM.
# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) des que
# le DNS du domaine pointe sur la VM et que les ports 80 et 443 sont ouverts.

# En-tetes de securite, importes deux fois : avec -Server, le bloc est differe,
# applique quand la route normale ecrit sa reponse. Une erreur part par
# handle_errors, qui ne passe pas par lui : la page d'attente les perdait.
(securite) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$JURIX_DOMAINE} {
	encode zstd gzip

	# L'API, sous /api/v1, et sa sonde. Meme origine que le front : aucun CORS.
	# flush_interval -1 : les reponses du chat arrivent en flux (SSE), mot apres
	# mot ; mises en tampon, elles n'apparaitraient qu'a la fin.
	handle /api/* {
		# Plafond par requete : sans lui, un envoi de 1 ou 2 Go saturait la
		# memoire de l'API. 300 Mo couvre le plus gros envoi prevu (250 Mo,
		# app/api/routes/upload.py).
		request_body {
			max_size 300MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Tout le reste : le serveur Node du front, qui rend les pages et sert les
	# fichiers du build (deja compresses, et /_app/immutable en cache un an :
	# rien a ajouter ici). Pendant qu'il redemarre (mise a jour), Caddy retente
	# la connexion jusqu'a 10 s au lieu de repondre aussitot 502.
	handle {
		reverse_proxy front:3000 {
			lb_try_duration 10s
		}
	}

	# Front ou API injoignable (conteneur arrete, ou qui redemarre) : une page
	# d'attente en 503, et non une 502 vide. Seules les erreurs levees par Caddy
	# arrivent ici : une reponse du front, meme un 503 qu'il rend lui-meme
	# quand l'API ne repond pas, passe telle quelle.
	handle_errors 502 503 504 {
		import securite
		root * /etc/caddy
		rewrite * /maintenance.html
		header Retry-After 30
		header Cache-Control no-store
		file_server {
			status 503
		}
	}

	import securite

	# Pas de journal d'acces : il ecrirait les URL entieres, dont le jeton
	# d'administration du WebSocket (?token=...) et les liens de
	# reinitialisation de mot de passe. Les erreurs de Caddy restent dans
	# `docker compose logs caddy`.
}
