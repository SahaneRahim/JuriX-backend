# Un seul domaine pour tout JuriX : le front et l'API, servis par la meme VM.
# Caddy obtient et renouvelle seul le certificat HTTPS (Let's Encrypt) des que
# le DNS du domaine pointe sur la VM et que les ports 80 et 443 sont ouverts.

{$JURIX_DOMAINE} {
	encode zstd gzip

	# L'API, sous /api/v1, et sa sonde. Meme origine que le front : aucun CORS.
	# flush_interval -1 : les reponses du chat arrivent en flux (SSE), mot apres
	# mot ; mises en tampon, elles n'apparaitraient qu'a la fin.
	handle /api/* {
		# Plafond par requete : sans lui, un envoi de 1 ou 2 Go saturait la
		# memoire de l'API. 300 Mo couvre le plus gros envoi prevu (250 Mo,
		# app/api/routes/upload.py).
		request_body {
			max_size 300MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Les fichiers construits du front. Ceux de /_app/immutable portent leur
	# empreinte dans leur nom : en cache un an. Un fichier absent repond 404, et
	# non index.html : apres une mise a jour, un onglet ouvert qui reclamait un
	# ancien morceau recevait du HTML a la place du JavaScript.
	handle /_app/* {
		root * /srv/front
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Le reste de l'application monopage : toute route inconnue rend
	# index.html, sans quoi un lien profond (/laws/123) repondrait 404.
	# no-cache : le navigateur revalide index.html a chaque visite. Sans
	# en-tete, il le gardait selon son heuristique et, apres une mise a jour,
	# reclamait des morceaux supprimes : page blanche.
	handle {
		root * /srv/front
		header Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Pas de journal d'acces : il ecrirait les URL entieres, dont le jeton
	# d'administration du WebSocket (?token=...) et les liens de
	# reinitialisation de mot de passe. Les erreurs de Caddy restent dans
	# `docker compose logs caddy`.
}
