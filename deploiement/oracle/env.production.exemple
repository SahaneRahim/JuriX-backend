# ============================================================
# JuriX — production sur la VM Oracle.
# Copier vers deploiement/oracle/.env SUR LA VM, renseigner, ne jamais
# versionner : ce fichier porte les secrets.
#
# Aucun commentaire en fin de ligne : docker compose le garderait dans la
# valeur.
# ============================================================

# ---- Domaine et base (lus par docker compose) ----
# Le sous-domaine qui pointe sur l'adresse IP publique de la VM.
JURIX_DOMAINE=jurix.exemple.cm
# Mot de passe de PostgreSQL, interne a la VM. Generer :
#   openssl rand -hex 24
# Vide : docker compose refuse de demarrer.
POSTGRES_PASSWORD=

# ---- Application ----
ENVIRONMENT=production
# false : sinon chaque requete SQL part dans les journaux.
DEBUG=false
# Signe les jetons de connexion. Generer : openssl rand -hex 32
# Vide, trop courte (moins de 32 caracteres) ou recopiee d'un exemple :
# l'API refuse de demarrer.
SECRET_KEY=
# Meme domaine que le front ; le CORS ne sert alors a rien, mais reste juste.
ALLOWED_ORIGINS=https://jurix.exemple.cm
# Racine des liens envoyes par courriel (verification, mot de passe oublie).
FRONTEND_BASE_URL=https://jurix.exemple.cm

# ---- Generation et classements ----
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
GROQ_API_KEY=
INTENT_CLASSIFIER=groq

# ---- Compte administrateur de la production ----
# La base est restauree SANS les comptes de developpement : demarrer.sh cree
# celui-ci s'il n'existe aucun administrateur (scripts/create_admin.py, qui
# ne remet jamais un mot de passe deja pose).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Embeddings : EmbeddingGemma en local (monte par docker-compose.yml) ----
EMBEDDING_PROVIDER=gemma

# ---- Courriel (Brevo), facultatif ----
# Vide : inscription et connexion marchent, sans courriel de verification.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JuriX

# ---- Connexion Google, facultative ----
GOOGLE_CLIENT_ID=
