# ============================================================
# JuriX — production sur la VM Oracle.
# Copier vers deploiement/oracle/.env SUR LA VM, renseigner, ne jamais
# versionner : ce fichier porte les secrets.
#
# docker compose interprete chaque valeur : apres un espace, # ouvre un
# commentaire qui coupe la valeur, et $NOM est remplace par une variable (vide
# si absente). Donc ni commentaire en fin de ligne, ni $ dans une valeur.
# ============================================================

# ---- Domaine et base (lus par docker compose) ----
# Le sous-domaine qui pointe sur l'adresse IP publique de la VM, seul (sans
# https://), sans guillemets ni espaces : deployer.sh et demarrer.sh le lisent
# tel quel, et le figent dans le front. Le meme que JURIX_DOMAINE au moment de
# lancer deployer.sh, qui refuse sinon.
JURIX_DOMAINE=jurix.exemple.cm
# Mot de passe de PostgreSQL, interne a la VM. Generer :
#   openssl rand -hex 24
# Vide : docker compose refuse de demarrer.
POSTGRES_PASSWORD=

# ---- Application ----
ENVIRONMENT=production
# false : sinon chaque requete SQL part dans les journaux.
DEBUG=false
# Signe les jetons de connexion. Generer : openssl rand -hex 32
# Vide, trop courte (moins de 32 caracteres) ou recopiee d'un exemple :
# l'API refuse de demarrer.
SECRET_KEY=
# ALLOWED_ORIGINS et FRONTEND_BASE_URL (racine des liens des courriels) sont
# derives de JURIX_DOMAINE par docker-compose.yml : rien a renseigner.

# ---- Generation et classements ----
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
GROQ_API_KEY=
INTENT_CLASSIFIER=groq

# ---- Compte administrateur de la production ----
# La base est restauree SANS les comptes de developpement : demarrer.sh cree
# celui-ci s'il n'existe aucun administrateur (scripts/create_admin.py, qui
# ne remet jamais un mot de passe deja pose).
ADMIN_EMAIL=
# 8 a 100 caracteres, dont une majuscule, une minuscule et un chiffre ; ni $,
# ni #, ni guillemets, ni espace au bord. demarrer.sh refuse sinon, avant
# toute construction.
ADMIN_PASSWORD=

# ---- Embeddings : API Voyage AI (voyage-4-large) ----
# Le compte de cette cle doit avoir un moyen de paiement : sans lui, Voyage
# bride a 3 requetes et 10 000 jetons par minute pour tout le site. Une cle
# distincte de celle du poste de developpement est preferable.
# Vide : demarrer.sh refuse de demarrer. Le fournisseur est fige a voyage par
# docker-compose.yml : ne pas ajouter EMBEDDING_PROVIDER ici.
VOYAGE_API_KEY=

# ---- Courriel (Brevo), facultatif ----
# Vide : inscription et connexion marchent, sans courriel de verification.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JuriX

# ---- Connexion Google, facultative ----
# Sans guillemets ni espaces : deployer.sh la lit telle quelle pour la figer
# dans le front.
GOOGLE_CLIENT_ID=
